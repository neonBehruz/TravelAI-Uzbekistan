# ============================================================================
# SAFAR AI - Environment Configuration Template
# ============================================================================

# Backend API Environment
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000

# Database Configuration (PostgreSQL 18)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=safarai_db;Username=postgres;Password=YOUR_POSTGRES_PASSWORD;

# JWT Security
Jwt__Key=YOUR_SUPER_SECRET_JWT_KEY_MINIMUM_32_CHARACTERS_LONG!
Jwt__Issuer=SafarAiBackend
Jwt__Audience=SafarAiFrontend

# AI Services Configuration
# Options: IntelligentKnowledgeEngine, OpenAI, Anthropic, Gemini, Ollama
AiProvider__Provider=IntelligentKnowledgeEngine
AiProvider__ApiKey=YOUR_AI_PROVIDER_API_KEY
AiProvider__ModelName=gpt-4o-mini

# Map & Geocoding Provider
MapProvider__ApiKey=YOUR_MAP_TILES_API_KEY

# Frontend Environment
VITE_API_URL=http://localhost:5000/api
